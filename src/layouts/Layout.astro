---
// Self-hosted Nunito Variable — replaces Filson Pro from Adobe Typekit
// for body/UI/headings. Bundled with the site (Vercel edge), so it loads
// from the same origin: no DNS lookup, no render-blocking CDN call,
// rock-solid Polish characters. Typekit kit still loads in <head> for
// 'learning-curve' (decorative scattered letters + logo glyph style).
import '@fontsource-variable/nunito';
import '@fontsource-variable/nunito/wght-italic.css';

import '~/assets/styles/tailwind.css';

import { I18N } from 'astrowind:config';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import SchemaOrg from '~/components/seo/SchemaOrg.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
const isStaging = import.meta.env.PUBLIC_IS_STAGING === 'true';
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <SchemaOrg />

    <!-- Adobe Typekit — preconnect early, but load the stylesheet
         non-blocking so it doesn't gate first paint (~1.5s saving on
         PageSpeed). Fonts will swap in as they arrive with
         font-display: swap (set in CustomStyles.astro). -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://use.typekit.net/sni5mcg.css"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript><link rel="stylesheet" href="https://use.typekit.net/sni5mcg.css" /></noscript>

    <!-- Staging: noindex -->
    {isStaging && <meta name="robots" content="noindex,nofollow" />}

    <!-- GTM head snippet -->
    <script is:inline>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-5ZVT7T4V');
    </script>

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <!-- GTM noscript fallback -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5ZVT7T4V"
        height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    <slot />

    <BasicScripts />

    <!-- GTM: push pageview on each View Transition navigation -->
    <script is:inline>
      document.addEventListener('astro:page-load', function() {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'virtualPageview',
          page_path: window.location.pathname,
          page_title: document.title,
        });
      });
    </script>

    <!-- Scroll-reveal: observe [data-reveal] elements, add .is-revealed on
         first intersection. Re-runs after every View Transition navigation
         (astro:page-load fires on initial load too). Elements already
         revealed are skipped, so re-init is cheap. -->
    <script is:inline>
      document.addEventListener('astro:page-load', function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('[data-reveal]').forEach(function (el) {
            el.classList.add('is-revealed');
          });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              var el = entry.target;
              el.classList.add('is-revealed');
              io.unobserve(el);
              // Once the entrance transition finishes, strip the attribute so
              // the element returns to its normal Tailwind transitions —
              // otherwise hover effects (e.g. card lift) inherit the slow
              // 0.8s reveal timing.
              el.addEventListener('transitionend', function onEnd(e) {
                if (e.target === el && (e.propertyName === 'opacity' || e.propertyName === 'clip-path')) {
                  el.removeAttribute('data-reveal');
                  el.removeEventListener('transitionend', onEnd);
                }
              });
            }
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -48px 0px' });

        document.querySelectorAll('[data-reveal]:not(.is-revealed)').forEach(function (el) {
          io.observe(el);
        });
      });
    </script>

    <!-- Lenis inertia smooth-scroll — the 'expensive site' glide. Desktop
         pointer-fine only; touch devices keep native momentum scrolling.
         Instance persists across View Transitions (document survives). -->
    <script>
      import Lenis from 'lenis';

      const w = window as unknown as { __lenis?: Lenis };
      if (
        !w.__lenis &&
        window.matchMedia('(pointer: fine)').matches &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const lenis = new Lenis({ lerp: 0.09 });
        w.__lenis = lenis;
        const raf = (time: number) => {
          lenis.raf(time);
          requestAnimationFrame(raf);
        };
        requestAnimationFrame(raf);
      }
    </script>

    <!-- Scroll-linked motion engine: continuous (not one-shot) movement.
         [data-float] drifts vertically at data-speed relative to viewport
         center (sets --float-y, consumed inside the element's transform).
         [data-marquee] slides horizontally across its viewport transit
         (data-marquee-speed = total px of travel). rAF-throttled, skips
         offscreen elements, inert under prefers-reduced-motion. -->
    <script is:inline>
      if (!window.__floatInit) {
        window.__floatInit = true;
        var floatItems = [];
        var floatTicking = false;

        function floatCollect() {
          floatItems = Array.prototype.slice.call(
            document.querySelectorAll('[data-float], [data-marquee]')
          );
        }

        function floatUpdate() {
          floatTicking = false;
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          var vh = window.innerHeight;
          floatItems.forEach(function (el) {
            var r = el.getBoundingClientRect();
            if (r.bottom < -120 || r.top > vh + 120) return;
            if (el.hasAttribute('data-marquee')) {
              var p = (vh - r.top) / (vh + r.height);
              p = Math.max(0, Math.min(1, p));
              var dist = parseFloat(el.getAttribute('data-marquee-speed')) || 400;
              el.style.transform = 'translate3d(' + (-p * dist).toFixed(1) + 'px, 0, 0)';
            } else {
              var speed = parseFloat(el.getAttribute('data-speed')) || 0.08;
              var offCenter = r.top + r.height / 2 - vh / 2;
              el.style.setProperty('--float-y', (-offCenter * speed).toFixed(1) + 'px');
            }
          });
        }

        function floatSchedule() {
          if (floatTicking) return;
          floatTicking = true;
          requestAnimationFrame(floatUpdate);
        }

        window.addEventListener('scroll', floatSchedule, { passive: true });
        window.addEventListener('resize', floatSchedule, { passive: true });
        document.addEventListener('astro:page-load', function () {
          floatCollect();
          floatSchedule();
        });
      }
    </script>
  </body>
</html>
