---
// Plan zajęć na rok szkolny — dla rodziców, ale strona jest publiczna:
// pokazuje ofertę i nie zawiera żadnych danych osobowych.
//
// Godziny pochodzą z src/data/plan-zajec.ts — tego samego pliku, z którego
// powstaje PDF do pobrania. Poprawka godziny w jednym miejscu przechodzi
// na obie wersje, więc strona nie może rozjechać się z wydrukiem.
import Layout from '~/layouts/PageLayout.astro';
import HeroMazy from '~/components/widgets/HeroMazy.astro';
import SchemaBreadcrumbs from '~/components/seo/SchemaBreadcrumbs.astro';
import { wczytajPlan, DNI, ROK_SZKOLNY } from '~/data/plan-zajec.mjs';

const metadata = {
  title: `Plan zajęć ${ROK_SZKOLNY} – Kolorowe Przedszkole Saska Kępa`,
  description:
    'Tygodniowy plan zajęć w Kolorowym Przedszkolu: zajęcia dydaktyczne, język angielski codziennie, rytmika, gimnastyka, taniec i zajęcia dodatkowe.',
  canonical: 'https://koloroweprzedszkole.com/plan-zajec',
  ignoreTitleTemplate: true,
  robots: { index: true, follow: true },
};

// Plan pochodzi z Arkusza Google; przy niedostępnym arkuszu wraca ostatni
// znany plan z repozytorium (patrz src/data/plan-zajec.ts).
const { plan: PLAN, zrodlo } = await wczytajPlan();
console.log('[plan zajęć] źródło danych: ' + zrodlo);

// Zajęcia z ustalonym terminem trafiają do tabeli, reszta na listę pod nią —
// pusty wiersz w siatce wygląda jak błąd, a to po prostu jeszcze nieustalony
// termin.
const zPlanem = PLAN.filter((z) => Object.keys(z.terminy).length > 0);
const bezTerminu = PLAN.filter((z) => Object.keys(z.terminy).length === 0);

// Widok mobilny idzie dzień po dniu — rodzic patrzy zwykle na „co dziś".
const wgDni = DNI.map((dzien) => ({
  dzien,
  pozycje: zPlanem
    .filter((z) => z.terminy[dzien])
    .map((z) => ({ nazwa: z.nazwa, godzina: z.terminy[dzien]! }))
    .sort((a, b) => a.godzina.localeCompare(b.godzina)),
}));

const kartaCls = 'bg-white rounded-2xl border border-brand-navy/6 shadow-sm';
---

<Layout metadata={metadata}>
  <HeroMazy title="plan" seoHeading={`Plan zajęć ${ROK_SZKOLNY} — Kolorowe Przedszkole`} />

  <section class="bg-brand-cream pt-16 md:pt-24 pb-20">
    <div class="max-w-6xl mx-auto px-6">

      <div class="text-center mb-10 md:mb-14">
        <p class="font-sans font-bold uppercase tracking-widest text-xs text-brand-teal">
          Rok szkolny {ROK_SZKOLNY}
        </p>
        <h2 class="font-sans italic text-[clamp(1.8rem,3.5vw,2.8rem)] text-brand-navy leading-tight mt-3 mb-4">
          Plan zajęć
        </h2>
        <p class="font-sans text-brand-navy/70 leading-relaxed max-w-2xl mx-auto">
          Tak wygląda tydzień w Kolorowym Przedszkolu. Zajęcia dydaktyczne i język angielski
          odbywają się codziennie, pozostałe w stałych dniach tygodnia.
        </p>

        <a
          href="/dokumenty/plan-zajec-2026-2027.pdf"
          target="_blank"
          rel="noopener"
          class="cta-pop mt-8 inline-flex items-center gap-2 bg-brand-teal text-brand-cream
                 font-sans font-bold uppercase tracking-wider text-sm px-7 py-3.5 rounded-lg
                 hover:bg-brand-coral transition-colors duration-200"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" />
          </svg>
          Pobierz plan w PDF
        </a>
      </div>

      <!-- ── Tabela tygodniowa (od tabletu w górę) ───────────────── -->
      <div class={`${kartaCls} hidden md:block overflow-hidden`}>
        <table class="w-full border-collapse">
          <thead>
            <tr class="bg-brand-navy/4">
              <th class="text-left font-sans text-sm font-bold text-brand-navy px-5 py-4 w-56">
                Zajęcia
              </th>
              {DNI.map((dzien) => (
                <th class="font-sans text-sm font-bold text-brand-navy px-3 py-4 capitalize border-l border-brand-navy/8">
                  {dzien}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {zPlanem.map((z, i) => (
              <tr class={i % 2 ? 'bg-brand-navy/2' : ''}>
                <th scope="row" class="text-left align-top px-5 py-3.5 border-t border-brand-navy/8">
                  <span class="font-sans text-sm font-semibold text-brand-navy">{z.nazwa}</span>
                  {z.opis && (
                    <span class="block font-sans text-xs text-brand-navy/45 mt-0.5">{z.opis}</span>
                  )}
                </th>
                {DNI.map((dzien) => (
                  <td class="text-center px-3 py-3.5 border-t border-l border-brand-navy/8">
                    {z.terminy[dzien] ? (
                      <span class="inline-block font-sans text-sm font-semibold text-brand-navy
                                   bg-brand-teal/10 rounded-md px-2.5 py-1 whitespace-nowrap">
                        {z.terminy[dzien]}
                      </span>
                    ) : (
                      <span class="font-sans text-brand-navy/20" aria-hidden="true">—</span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- ── Widok dzienny (telefon) ──────────────────────────────── -->
      <div class="md:hidden flex flex-col gap-4">
        {wgDni.map(({ dzien, pozycje }) => (
          <div class={`${kartaCls} p-5`}>
            <p class="font-sans font-bold uppercase tracking-widest text-xs text-brand-teal mb-3 capitalize">
              {dzien}
            </p>
            {pozycje.length ? (
              <ul class="flex flex-col gap-2.5">
                {pozycje.map((p) => (
                  <li class="flex items-baseline justify-between gap-4">
                    <span class="font-sans text-sm text-brand-navy">{p.nazwa}</span>
                    <span class="font-sans text-sm font-semibold text-brand-navy whitespace-nowrap">
                      {p.godzina}
                    </span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="font-sans text-sm text-brand-navy/45">Brak zajęć w planie.</p>
            )}
          </div>
        ))}
      </div>

      {bezTerminu.length > 0 && (
        <div class={`${kartaCls} p-6 md:p-8 mt-6`}>
          <p class="font-sans font-bold uppercase tracking-widest text-xs text-brand-teal mb-3">
            Terminy w ustaleniu
          </p>
          <p class="font-sans text-sm text-brand-navy/65 leading-relaxed mb-4">
            Te zajęcia są w ofercie, ale ich godziny ustalamy na początku roku.
            Podamy je, gdy tylko będą znane.
          </p>
          <ul class="flex flex-wrap gap-2">
            {bezTerminu.map((z) => (
              <li class="font-sans text-sm text-brand-navy border border-brand-navy/10 rounded-lg px-3.5 py-1.5">
                {z.nazwa}
              </li>
            ))}
          </ul>
        </div>
      )}

      <p class="font-sans text-xs text-brand-navy/45 mt-8 text-center leading-relaxed">
        Plan może się zmienić — o każdej zmianie informujemy rodziców.
        Pytania? Zadzwoń: <a href="tel:605657366" class="text-brand-teal underline hover:text-brand-coral transition-colors duration-200">605 657 366</a>
      </p>

    </div>
  </section>

  <SchemaBreadcrumbs
    items={[
      { name: 'Strona główna', url: 'https://koloroweprzedszkole.com/' },
      { name: 'Plan zajęć', url: 'https://koloroweprzedszkole.com/plan-zajec' },
    ]}
  />
</Layout>
