---
// Prośba o opinię w Google — okienko na stronach planu zajęć.
//
// Pojawia się po 8 sekundach i tylko raz w danej przeglądarce. Znacznik
// w localStorage zapisujemy w chwili pokazania, a nie zamknięcia — inaczej
// odświeżenie strony z otwartym okienkiem pokazałoby je drugi raz. Gdy
// localStorage jest niedostępny (tryb prywatny, blokada), okienko się nie
// pokazuje wcale: nie dałoby się dotrzymać „tylko raz".
//
// <dialog> daje bez własnego kodu zamykanie klawiszem Esc, blokadę strony
// pod spodem i poprawną obsługę czytników ekranu.
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import headerMazy from '~/assets/images/header-mazy.png';

interface Props {
  /** Slug grupy z planu — Wiewiórki mają osobną wizytówkę w Google. */
  grupa: string;
}

const { grupa } = Astro.props;

const OPINIE_GOOGLE: Record<string, string> = {
  wiewiorki: 'https://g.page/r/CVkFrqcq6j9vEAE/review',
};
const OPINIE_GOOGLE_POZOSTALE = 'https://g.page/r/CVZjcxfIdMKOEAE/review';
const link = OPINIE_GOOGLE[grupa] ?? OPINIE_GOOGLE_POZOSTALE;
---

<dialog
  data-opinia
  aria-labelledby="opinia-tytul"
  class="opinia m-auto w-[calc(100%-2rem)] max-w-md max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-3xl border-0 p-0 bg-white shadow-2xl backdrop:bg-brand-navy/50"
>
  <div class="relative">
    <!-- eager: okienko jest ukryte do 8. sekundy, więc leniwy obrazek
         zacząłby się ładować dopiero przy otwarciu i pasek wskakiwałby
         z opóźnieniem. To kilka KB. -->
    <Image
      src={headerMazy}
      alt=""
      aria-hidden="true"
      widths={[480, 960]}
      sizes="448px"
      loading="eager"
      class="w-full h-20 object-cover"
    />
    <button
      type="button"
      data-zamknij
      aria-label="Zamknij"
      class="absolute top-3 right-3 flex items-center justify-center w-9 h-9 rounded-full bg-brand-cream text-brand-navy hover:bg-white transition-colors duration-200 cursor-pointer"
    >
      <Icon name="tabler:x" class="w-5 h-5" aria-hidden="true" />
    </button>
  </div>

  <div class="px-7 pt-6 pb-7 text-center">
    <p class="text-brand-yellow text-2xl tracking-[0.3em]" aria-hidden="true">★★★★★</p>
    <p class="font-sans font-bold uppercase tracking-widest text-xs text-brand-teal mt-3">Drodzy Rodzice</p>
    <h2 id="opinia-tytul" class="font-sans italic text-3xl text-brand-navy leading-tight mt-2">
      Kilka ciepłych słów?
    </h2>
    <p class="font-sans text-brand-navy/70 leading-relaxed mt-4">
      Od 1991 roku tworzymy Kolorowe Przedszkole razem z rodzicami. Jeśli czują się Państwo u nas jak w domu,
      będzie nam niezmiernie miło, gdy napiszą o tym Państwo w Google. Zajmie to minutę, a innym rodzinom
      pomoże nas poznać.
    </p>

    <a
      href={link}
      target="_blank"
      rel="noopener"
      data-zamknij
      class="cta-pop mt-6 flex items-center justify-center gap-2 w-full font-sans font-bold uppercase tracking-wider text-sm px-6 py-3.5 rounded-lg bg-brand-teal text-brand-cream hover:bg-brand-coral transition-colors duration-200"
    >
      <Icon name="tabler:brand-google" class="w-4 h-4" aria-hidden="true" />
      Napisz opinię w Google
    </a>
    <button
      type="button"
      data-zamknij
      class="mt-3 font-sans text-sm text-brand-navy/50 hover:text-brand-navy underline underline-offset-4 transition-colors duration-200 cursor-pointer"
    >
      Zamknij
    </button>
  </div>
</dialog>

<style>
  .opinia[open] {
    animation: opinia-wejscie 0.35s ease-out;
  }

  .opinia[open]::backdrop {
    animation: opinia-tlo 0.35s ease-out;
  }

  @keyframes opinia-wejscie {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
  }

  @keyframes opinia-tlo {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .opinia[open],
    .opinia[open]::backdrop {
      animation: none;
    }
  }
</style>

<script>
  const KLUCZ = 'kp-opinia-google-pokazana';
  const OPOZNIENIE_MS = 8000;
  let zegar: number | undefined;

  function przygotuj() {
    const okno = document.querySelector<HTMLDialogElement>('dialog[data-opinia]');
    if (!okno) return;

    okno.querySelectorAll('[data-zamknij]').forEach((el) => el.addEventListener('click', () => okno.close()));
    // Kliknięcie w przyciemnione tło, poza kartą, też zamyka okienko.
    okno.addEventListener('click', (e) => {
      if (e.target === okno) okno.close();
    });

    try {
      if (localStorage.getItem(KLUCZ)) return;
    } catch {
      return;
    }

    zegar = window.setTimeout(() => {
      try {
        localStorage.setItem(KLUCZ, new Date().toISOString());
      } catch {
        return;
      }
      okno.showModal();
    }, OPOZNIENIE_MS);
  }

  // Strona korzysta z płynnych przejść (ClientRouter): skrypt wykonuje się raz,
  // a astro:page-load przychodzi przy każdym wejściu na stronę.
  document.addEventListener('astro:page-load', przygotuj);
  // Przejście na inną stronę kasuje odliczanie — okienko nie wyskoczy tam, gdzie
  // go nie ma, ani na planie innej grupy po 3 sekundach zamiast po 8.
  document.addEventListener('astro:before-swap', () => window.clearTimeout(zegar));
</script>
