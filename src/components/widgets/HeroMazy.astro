---
// Reusable hero band for subpages. Designer's colorful "mazy" pattern as the
// band background, with a massive lowercase decorative wordmark in cream
// bleeding past the band edge (knockout / fade effect).
//
// SEO/A11y structure (per audit fix):
// - The real <h1> is sr-only with the full descriptive heading — what
//   Google + screen readers receive.
// - The visible knockout wordmark is a separate <span aria-hidden="true">,
//   purely decorative. Sighted users see only the lowercase short word.
//
// Usage:
//   <HeroMazy
//     title="kuchnia"
//     seoHeading="Kuchnia — domowe obiady gotowane na miejscu"
//   />
import { Image } from 'astro:assets';
import headerMazy from '~/assets/images/header-mazy.png';

interface Props {
  title: string;          // Visible decorative wordmark, e.g. "kuchnia"
  seoHeading?: string;    // Full H1 text for Google/screen readers
}

const { title, seoHeading } = Astro.props;
const heading = seoHeading || title;

// Jedna lista klas dla obu kopii napisu. Rozjazd choćby o pół piksela
// rozmyłby obrys, więc typografia nie może istnieć w dwóch miejscach.
const napisCls =
  'block px-6 text-center font-sans font-black text-[clamp(4.5rem,16vw,12rem)] ' +
  'text-brand-cream leading-[0.85] tracking-tight lowercase ' +
  'translate-y-[13%] md:translate-y-[17%]';
---

<div class="relative">
  <Image
    src={headerMazy}
    alt=""
    aria-hidden="true"
    class="w-full h-40 md:h-52 lg:h-60 object-cover"
    loading="eager"
    fetchpriority="high"
    widths={[768, 1280, 1920]}
    sizes="100vw"
  />

  <!-- Real H1 — visually hidden, full SEO-friendly heading. -->
  <h1 class="sr-only">{heading}</h1>

  <!-- Visible knockout-bleed wordmark — decorative only (aria-hidden so
       screen readers don't double-announce the page topic).

       Dwie kopie tego samego słowa leżą dokładnie na sobie. Widoczna jest
       zawsze pierwsza — czysty krem, bez żadnego obrysu. Druga niesie
       wyłącznie włosową kreskę i jest przycięta do fragmentu poniżej paska,
       więc obrys pojawia się tylko tam, gdzie litera wchodzi na kremowe tło
       i inaczej by zniknęła. Na kolorowym pasku napis zostaje nietknięty. -->
  <div class="absolute inset-x-0 bottom-0 pointer-events-none" aria-hidden="true">
    <div class="relative">
      <span class={napisCls}>{title}</span>
      <span class={`${napisCls} napis-dol absolute inset-0`}>{title}</span>
    </div>
  </div>
</div>

<style>
  /* Kreska w kolorze o włos ciemniejszym od kremu (#FCF6F0) — ma domknąć
     kształt litery, a nie rysować ramkę. 0.75 px to najcieńsza linia, jaka
     wychodzi równo także na ekranie 1×; przy 0.5 px przeglądarki zaczynają
     ją gubić na łagodnych łukach. Kolor #E4D8CA to krem przyciemniony
     o kilka procent — widać kształt, nie widać obwódki.

     paint-order rysuje obrys pod wypełnieniem, więc litera nie chudnie —
     widać wyłącznie zewnętrzną połowę kreski.

     Cięcie: napis jest przesunięty w dół o 13% (md: 17%) własnej wysokości,
     czyli dokładnie tyle wystaje poniżej paska. Wielokąt zaczyna się więc
     na 87% (md: 83%) wysokości i sięga daleko w dół, żeby zmieścić ogonki
     liter wychodzące poza pudełko wiersza. Styk cięcia wypada co do piksela
     na krawędzi paska, gdzie tło i tak zmienia kolor — dlatego jest
     niewidoczny. */
  .napis-dol {
    -webkit-text-stroke: 0.75px #E4D8CA;
    paint-order: stroke fill;
    clip-path: polygon(-5% 87%, 105% 87%, 105% 300%, -5% 300%);
  }

  @media (min-width: 768px) {
    .napis-dol {
      clip-path: polygon(-5% 83%, 105% 83%, 105% 300%, -5% 300%);
    }
  }
</style>
