---
// Ikona wydarzenia w kropce na osi czasu. Kształty własnych ikon i przypisanie
// ikon z zestawu Tabler są w src/data/ikony-wydarzen.mjs — z tego samego
// pliku rysuje je PDF, więc wydruk ma te same ikony co strona.
import { Icon } from 'astro-icon/components';
import { IKONY_WLASNE, IKONY_Z_ZESTAWU, DOMYSLNA_IKONA } from '~/data/ikony-wydarzen.mjs';

interface Props {
  nazwa?: string;
  class?: string;
}

const { nazwa = '', class: klasa = 'w-6 h-6' } = Astro.props;
const wlasne: string[] | undefined = IKONY_WLASNE[nazwa];
---

{
  wlasne ? (
    <svg
      class={klasa}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {wlasne.map((d) => (
        <path d={d} />
      ))}
    </svg>
  ) : (
    <Icon name={IKONY_Z_ZESTAWU[nazwa] ?? DOMYSLNA_IKONA} class={klasa} aria-hidden="true" />
  )
}
