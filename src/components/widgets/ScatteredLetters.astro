---
// Reusable decorative background — handwritten letters scattered across a
// section, drifting at individual speeds as the page scrolls (parallax
// depth). Drop inside any section that has `relative overflow-hidden`,
// and add `relative z-10` to the content wrapper so it paints above.
//
// Motion: the float engine in Layout.astro sets --float-y per element
// (scroll-linked, rAF). The inline transform composes it with the static
// position/rotation. Bigger letters get higher speeds — reads as closer
// to the viewer. Inert under prefers-reduced-motion (engine bails).
//
// Letters render via CSS ::before (.deco-* classes in tailwind.css) so no
// letter characters sit in the HTML source (crawler hygiene).

const XL = 'text-[5rem] md:text-[8rem]';
const MD = 'text-4xl md:text-7xl';
const SM = 'text-3xl md:text-5xl';

const letters = [
  // Top
  { c: 'k', top: '4%',  left: '6%',  size: SM, rot: -32, speed: 0.05 },
  { c: 'l', top: '8%',  left: '20%', size: MD, rot: -45, speed: -0.07 },
  { c: 'O', top: '6%',  left: '50%', size: XL, rot: -8,  speed: 0.12 },
  { c: 'r', top: '10%', left: '74%', size: SM, rot: 22,  speed: -0.04 },
  { c: 'w', top: '4%',  left: '92%', size: MD, rot: 38,  speed: 0.08 },

  // Middle-left
  { c: 'e', top: '30%', left: '4%',  size: MD, rot: 24,  speed: -0.09 },
  { c: 'k', top: '52%', left: '2%',  size: XL, rot: -22, speed: 0.14 },
  { c: 'r', top: '74%', left: '6%',  size: SM, rot: -28, speed: 0.04 },

  // Middle-right
  { c: 'l', top: '32%', left: '96%', size: SM, rot: -20, speed: 0.06 },
  { c: 'O', top: '54%', left: '98%', size: MD, rot: 28,  speed: -0.08 },
  { c: 'w', top: '76%', left: '95%', size: SM, rot: 32,  speed: 0.05 },

  // Bottom
  { c: 'e', top: '92%', left: '12%', size: MD, rot: -15, speed: 0.1  },
  { c: 'r', top: '95%', left: '30%', size: SM, rot: 30,  speed: -0.05 },
  { c: 'l', top: '88%', left: '48%', size: MD, rot: -32, speed: 0.07 },
  { c: 'O', top: '95%', left: '66%', size: SM, rot: 14,  speed: -0.06 },
  { c: 'w', top: '90%', left: '85%', size: MD, rot: -22, speed: 0.09 },
];
---

<div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true" data-nosnippet>
  {letters.map((l) => (
    <span
      class={`absolute text-brand-navy/12 leading-none deco-${l.c} ${l.size}`}
      data-float
      data-speed={l.speed}
      style={`top: ${l.top}; left: ${l.left}; transform: translate(-50%, calc(-50% + var(--float-y, 0px))) rotate(${l.rot}deg); font-family: 'learning-curve', sans-serif; font-weight: 400;`}
    />
  ))}
</div>
